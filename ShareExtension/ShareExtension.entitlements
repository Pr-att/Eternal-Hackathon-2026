<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	 Must contain the SAME App Group as the main app. Xcode normally manages
	 this file when you toggle the "App Groups" capability on the extension
	 target; this is the expected end state.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.hackathon.Eternal-Hackathon-2026</string>
	</array>
</dict>
</plist>
