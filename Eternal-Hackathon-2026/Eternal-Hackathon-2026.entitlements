<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	 Main app's App Group — MUST match the extension's group string exactly.
	 Xcode manages this file when you enable the "App Groups" capability on
	 the main app target.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.hackathon.Eternal-Hackathon-2026</string>
	</array>
</dict>
</plist>
